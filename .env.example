# Neon: Dashboard > your project > Connect > copy the connection string
DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Gemini Flash through OpenRouter (openrouter.ai > Keys). Requests are served only by Google (Vertex AI / AI Studio).
OPENROUTER_API_KEY=
# Optional fallback: a Google AI Studio key, used only when OPENROUTER_API_KEY is empty
GEMINI_API_KEY=
# Gemini Flash model (OpenRouter adds the google/ prefix)
GEMINI_MODEL=gemini-3.8-flash
# Let Gemini research each startup with Google Search before drafting (true/false)
GEMINI_SEARCH=true

# Resend: resend.com > API Keys
RESEND_API_KEY=
# Without a verified domain, keep onboarding@resend.dev
RESEND_FROM=FreshRaise <onboarding@resend.dev>
# Test mode: every approved email goes to this address instead of the founder.
# Without a verified domain, Resend only delivers to your own signup email, so set it to that.
RESEND_TEST_TO=you@example.com
# Rohit's 6 am summary email goes here (defaults to RESEND_TEST_TO). Sent only when drafts are waiting or a run fails.
DIGEST_TO=

# Required. Any long random string. Vercel sends it with the daily cron so strangers can't trigger runs.
CRON_SECRET=

# Optional. If set, the site asks for this password (any username). Empty = site is open.
APP_PASSWORD=

# Pipeline tuning (optional)
LOOKBACK_HOURS=24
MAX_ARTICLES_PER_RUN=100
MAX_DRAFTS_PER_RUN=10
# Max Gemini requests per minute (30 suits a paid OpenRouter key; use 10 for the AI Studio free tier)
GEMINI_RPM=30
# How long a run may work before stopping (ms). Keep it about 30s under maxDuration (300s).
TIME_BUDGET_MS=270000
# Backup USD to INR rate, used only if the live rate (Frankfurter) can't be reached
USD_INR=96
# Drafts leave the folder this many days after the announcement (article publish date)
ARCHIVE_AFTER_DAYS=7
